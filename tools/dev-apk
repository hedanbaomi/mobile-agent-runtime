set -eu

if [[ $# != 1 || ( $1 != arm64-v8a && $1 != x86_64 ) ]]; then
    echo "Usage: bash tools/dev-apk {arm64-v8a|x86_64}" >&2
    exit 2
fi
cd -- "$(dirname -- "$0")/.."
exec ./gradlew --offline --no-daemon --max-workers=2 --dependency-verification=strict \
    -PmarDevAbi="$1" :app-android:assembleDebug
