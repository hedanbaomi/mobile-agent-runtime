# MAR_INSTRUMENTATION_PARSER_BEGIN
import pathlib
import re
import sys
import xml.etree.ElementTree as ET

inst_path = pathlib.Path(sys.argv[1])
adb_exit = int(sys.argv[2])
xml_path = pathlib.Path(sys.argv[3])
suite_name = sys.argv[4]

raw_text = inst_path.read_text(encoding="utf-8", errors="replace").replace("\r\n", "\n").replace("\r", "\n")
lines = raw_text.split("\n")

PREFIXES = (
    "INSTRUMENTATION_STATUS: ",
    "INSTRUMENTATION_STATUS_CODE: ",
    "INSTRUMENTATION_RESULT: ",
    "INSTRUMENTATION_CODE: ",
    "INSTRUMENTATION_FAILED:",
    "INSTRUMENTATION_ABORTED:",
)
STD_STATUS_KEYS = {"id", "numtests", "current", "class", "test", "stream", "stack", "Error"}

status_bundle: dict[str, str] = {}
result_bundle: dict[str, str] = {}
active_section: str | None = None
current_key: str | None = None
declared_numtests: int | None = None
in_flight: dict[tuple[str, str], int] = {}
test_cases: list[tuple[str, str, str, str]] = []
passed_tests = 0
ignored_tests = 0
assumption_skipped_tests = 0
failed_tests = 0
inst_codes: list[int] = []
protocol_errors: list[str] = []
for line in lines:
    if line.startswith("INSTRUMENTATION_STATUS: "):
        active_section = "status"
        rest = line[len("INSTRUMENTATION_STATUS: "):]
        if "=" in rest:
            k, v = rest.split("=", 1)
            current_key = k.strip()
            status_bundle[current_key] = v
        else:
            current_key = None
    elif line.startswith("INSTRUMENTATION_STATUS_CODE: "):
        active_section = None
        current_key = None
        m = re.match(r"^INSTRUMENTATION_STATUS_CODE:\s*(-?\d+)\s*$", line)
        if m is None:
            protocol_errors.append(f"malformed INSTRUMENTATION_STATUS_CODE line: {line!r}")
            status_bundle.clear()
            continue
        code = int(m.group(1))
        if "numtests" in status_bundle:
            raw_nt = status_bundle["numtests"].strip()
            try:
                nt = int(raw_nt)
            except ValueError:
                protocol_errors.append(f"non-integer numtests={raw_nt!r}")
            else:
                if nt < 1:
                    protocol_errors.append(f"invalid numtests={nt} (must be >= 1)")
                elif declared_numtests is None:
                    declared_numtests = nt
                elif declared_numtests != nt:
                    protocol_errors.append(f"inconsistent numtests across stream: {declared_numtests} vs {nt}")

        test_name = status_bundle.get("test", "").strip()
        class_name = status_bundle.get("class", "").strip()
        extra_keys = set(status_bundle.keys()) - STD_STATUS_KEYS
        has_lifecycle_header = any(k in status_bundle for k in ("id", "numtests", "current"))

        if code >= 2:
            # Intermediate custom Instrumentation.sendStatus(>=2, metricsBundle) event.
            status_bundle.clear()
            continue
        if code == 0 and (not test_name or not class_name or (not has_lifecycle_header and bool(extra_keys))):
            # Intermediate custom Instrumentation.sendStatus(0, metricsBundle) event.
            status_bundle.clear()
            continue

        if test_name:
            cls = class_name or "unknown"
            key = (cls, test_name)
            if code == 1:
                in_flight[key] = in_flight.get(key, 0) + 1
            elif code == 0:
                if in_flight.get(key, 0) <= 0:
                    protocol_errors.append(f"orphan pass status (code 0 without start code 1) for {cls}#{test_name}")
                else:
                    in_flight[key] -= 1
                    if in_flight[key] == 0:
                        del in_flight[key]
                    passed_tests += 1
                    test_cases.append(("pass", cls, test_name, ""))
            elif code == -3:
                if in_flight.get(key, 0) > 0:
                    in_flight[key] -= 1
                    if in_flight[key] == 0:
                        del in_flight[key]
                ignored_tests += 1
                msg = status_bundle.get("stack", "").strip() or "ignored"
                test_cases.append(("skip", cls, test_name, msg))
            elif code == -4:
                if in_flight.get(key, 0) > 0:
                    in_flight[key] -= 1
                    if in_flight[key] == 0:
                        del in_flight[key]
                assumption_skipped_tests += 1
                msg = status_bundle.get("stack", "").strip() or "assumption failure"
                test_cases.append(("skip", cls, test_name, msg))
            else:
                if in_flight.get(key, 0) > 0:
                    in_flight[key] -= 1
                    if in_flight[key] == 0:
                        del in_flight[key]
                failed_tests += 1
                msg = status_bundle.get("stack", "").strip() or f"INSTRUMENTATION_STATUS_CODE: {code}"
                kind = "error" if code == -1 else "failure"
                test_cases.append((kind, cls, test_name, msg))
        elif code != 1:
            failed_tests += 1
            msg = (
                status_bundle.get("stack", "").strip()
                or status_bundle.get("Error", "").strip()
                or f"INSTRUMENTATION_STATUS_CODE: {code}"
            )
            test_cases.append(("error", class_name or "instrumentation.runner", "initializationError", msg))
        status_bundle.clear()
    elif line.startswith("INSTRUMENTATION_RESULT: "):
        active_section = "result"
        rest = line[len("INSTRUMENTATION_RESULT: "):]
        if "=" in rest:
            k, v = rest.split("=", 1)
            current_key = k.strip()
            result_bundle[current_key] = v
        else:
            current_key = None
    elif line.startswith("INSTRUMENTATION_CODE: "):
        active_section = None
        current_key = None
        m = re.match(r"^INSTRUMENTATION_CODE:\s*(-?\d+)\s*$", line)
        if m is None:
            protocol_errors.append(f"malformed INSTRUMENTATION_CODE line: {line!r}")
            inst_codes.append(0)
        else:
            inst_codes.append(int(m.group(1)))
    elif any(line.startswith(p) for p in PREFIXES):
        active_section = None
        current_key = None
        if line.startswith(("INSTRUMENTATION_FAILED:", "INSTRUMENTATION_ABORTED:")):
            protocol_errors.append(line.strip())
    elif current_key is not None:
        if active_section == "status":
            status_bundle[current_key] = status_bundle[current_key] + "\n" + line
        elif active_section == "result":
            result_bundle[current_key] = result_bundle[current_key] + "\n" + line
    elif line.strip().startswith(("Process crashed", "Native crash", "Unable to find instrumentation info")):
        protocol_errors.append(line.strip())

runner_reasons: list[str] = []
if adb_exit != 0:
    runner_reasons.append(f"adb exited with {adb_exit}")

short_msg = result_bundle.get("shortMsg", "").strip()
long_msg = result_bundle.get("longMsg", "").strip()
if short_msg or long_msg:
    runner_reasons.append(f"INSTRUMENTATION_RESULT error: shortMsg={short_msg!r} longMsg={long_msg!r}")

# Only the stream field carries the verdict; other final metrics may follow it.
stream_lines = [line.strip() for line in result_bundle.get("stream", "").splitlines() if line.strip()]
if "FAILURES!!!" in stream_lines:
    runner_reasons.append("JUnit reported FAILURES!!!")

runner_reasons.extend(protocol_errors)

for (cls, name), remaining in sorted(in_flight.items()):
    runner_reasons.append(f"unfinished test {cls}#{name} (started {remaining}x without terminal status)")
    for _ in range(remaining):
        test_cases.append((
            "error",
            cls,
            name,
            "Test started (INSTRUMENTATION_STATUS_CODE: 1) without terminal status before instrumentation ended",
        ))

if inst_codes != [-1]:
    runner_reasons.append(f"expected terminal INSTRUMENTATION_CODE [-1], got {inst_codes}")

non_empty = [ln.strip() for ln in lines if ln.strip()]
has_terminal_code_line = bool(non_empty and re.fullmatch(r"INSTRUMENTATION_CODE:\s*-1", non_empty[-1]))
if not has_terminal_code_line:
    tail_line = non_empty[-1] if non_empty else "<empty output>"
    runner_reasons.append(f"stream did not end with 'INSTRUMENTATION_CODE: -1' (tail={tail_line!r})")

# The OK summary is the last non-empty standalone line of that stream. Anything else
# must not be searched for `OK (...)`: a test name or a metric mentioning it is not a
# summary.
summary_line = stream_lines[-1] if stream_lines else ""
ok_match = re.fullmatch(r"OK \(([1-9]\d*) tests?\)", summary_line)
if ok_match is None:
    runner_reasons.append(
        f"final INSTRUMENTATION_RESULT: stream did not end with 'OK (<N> test[s])' summary (got {summary_line or '<empty>'!r})"
    )

completed_tests = passed_tests + ignored_tests + assumption_skipped_tests + failed_tests
if declared_numtests is None:
    runner_reasons.append("missing INSTRUMENTATION_STATUS: numtests")
elif completed_tests != declared_numtests:
    runner_reasons.append(f"completed test count {completed_tests} != declared numtests {declared_numtests}")

if completed_tests <= 0 or (passed_tests + assumption_skipped_tests) <= 0:
    runner_reasons.append(
        f"zero executed tests completed cleanly (passed={passed_tests}, assumption_skipped={assumption_skipped_tests}, ignored={ignored_tests})"
    )

if ok_match is not None:
    ok_count = int(ok_match.group(1))
    expected_ok_counts = {passed_tests + assumption_skipped_tests, completed_tests}
    if ok_count not in expected_ok_counts:
        runner_reasons.append(
            f"OK summary count {ok_count} != completed count "
            f"(passed={passed_tests}, assumption_skipped={assumption_skipped_tests}, ignored={ignored_tests}, completed={completed_tests})"
        )

reasons: list[str] = []
if failed_tests > 0:
    reasons.append(f"{failed_tests} failing/errored test status code(s)")
reasons.extend(runner_reasons)

if runner_reasons:
    detail_lines = list(runner_reasons)
    if short_msg:
        detail_lines.append(f"shortMsg: {short_msg}")
    if long_msg:
        detail_lines.append(f"longMsg: {long_msg}")
    test_cases.append((
        "error",
        "instrumentation.runner",
        "suiteExecutionError",
        "\n".join(detail_lines),
    ))

failures_n = sum(1 for kind, *_ in test_cases if kind == "failure")
errors_n = sum(1 for kind, *_ in test_cases if kind == "error")
skipped_n = sum(1 for kind, *_ in test_cases if kind == "skip")
if reasons and (failures_n + errors_n) == 0:
    test_cases.append(("error", "instrumentation.runner", "suiteExecutionError", "; ".join(reasons)))
    errors_n += 1

suite_el = ET.Element(
    "testsuite",
    {
        "name": suite_name,
        "tests": str(len(test_cases)),
        "failures": str(failures_n),
        "errors": str(errors_n),
        "skipped": str(skipped_n),
    },
)
for kind, cls, name, detail in test_cases:
    case_el = ET.SubElement(suite_el, "testcase", {"classname": cls, "name": name})
    if kind == "skip":
        skip_el = ET.SubElement(case_el, "skipped", {"message": detail.splitlines()[0] if detail else "skipped"})
        skip_el.text = detail
    elif kind in ("failure", "error"):
        err_el = ET.SubElement(case_el, kind, {"message": detail.splitlines()[0] if detail else kind})
        err_el.text = detail
xml_path.parent.mkdir(parents=True, exist_ok=True)
ET.ElementTree(suite_el).write(xml_path, encoding="utf-8", xml_declaration=True)

if reasons:
    sys.stderr.write("run-device-suite: instrumentation validation FAILED: " + "; ".join(reasons) + "\n")
    sys.exit(adb_exit if adb_exit != 0 else 1)
# MAR_INSTRUMENTATION_PARSER_END
PY
  else
    declare -a gradle_args=(
      ":app-android:connected${variant}AndroidTest"
