      "onPrimary": "#1E429F",
      "primaryContainer": "#233876",
      "onPrimaryContainer": "#E1EFFE",
      "secondary": "#9CA3AF",
      "onSecondary": "#1F2A37",
      "secondaryContainer": "#374151",
      "onSecondaryContainer": "#F3F4F6",
      "tertiary": "#31C48D",
