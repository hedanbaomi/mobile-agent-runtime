  "version": "1.1.0",
  "name": "mobileAgentRuntime Design Tokens",
  "description": "Design tokens for Android Material 3 implementation across light and dark themes with Simplified Chinese (zh-CN) typography support",
  "localization": {
    "defaultLocale": "zh-CN",
    "supportedLocales": ["zh-CN", "en-US"],
    "fallbackLocale": "en-US"
  },
  "color": {
